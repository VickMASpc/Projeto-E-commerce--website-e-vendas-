## Modo interno padrão: dashboard consumindo a API Python com Firebase configurado
VITE_DASHBOARD_MODE=internal_api
VITE_STATS_API_URL=http://127.0.0.1:5000/stats
# Opcional: envie o mesmo token configurado em API_TOKEN no servidor Python.
# VITE_API_TOKEN=troque-este-token

## Modo teste: permite fallback offline explícito
# VITE_DASHBOARD_MODE=test
# VITE_ALLOW_OFFLINE_FALLBACK=true

## Se no futuro o dashboard for exposto remotamente, aponte VITE_STATS_API_URL para o endpoint HTTPS publicado.
